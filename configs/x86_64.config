# ============================================================
# 目标：x86/64 —— 64 位 x86_64（amd64），最常用的软路由 / 小主机 / 虚拟机
# 产物：squashfs / ext4 的 combined（BIOS）与 combined-efi（UEFI）镜像
# ============================================================

# ---------- 目标定义 ----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

# ---------- 分区大小 ----------
# 根分区 1G，方便后续装 docker / 大量插件；镜像为稀疏文件，压缩后体积正常
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ---------- 存储 / USB ----------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_lsblk=y

# ---------- 网卡（x86 默认已含 intel/realtek 大部分驱动，这里补充常见 USB 网卡）----------
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y
CONFIG_PACKAGE_kmod-usb-net-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
