# ============================================================
# ImmortalWrt 通用编译配置（所有目标共用）
# 生成 .config 时会被拼接到最前面，目标配置文件在后，可覆盖此处同名选项
# ============================================================

# ---------- 镜像格式 ----------
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_TARGET_ROOTFS_CPIOGZ=n
CONFIG_ISO_IMAGES=n
CONFIG_QCOW2_IMAGES=n
CONFIG_VDI_IMAGES=n
CONFIG_VMDK_IMAGES=n
CONFIG_VHDX_IMAGES=n

# ---------- ccache（加快重复编译）----------
CONFIG_CCACHE=y

# ---------- LuCI 基础 ----------
CONFIG_PACKAGE_luci=y
# 只用 openssl 一个 ustream-ssl 后端：luci-ssl 走 mbedtls，会和已装的
# libustream-openssl 抢同一个 libustream-ssl.so（opkg 报 check_data_file_clashes）
# CONFIG_PACKAGE_luci-ssl is not set
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_px5g-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_libustream-wolfssl is not set

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ---------- 中文语言包 ----------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---------- Turbo ACC：BBR + 流量分载 + FullCone NAT ----------
# luci-app-turboacc 为本仓库内置的自研包（package/luci-app-turboacc）
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ---------- nikki（mihomo 透明代理，默认内置）----------
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_mihomo-meta=y

# ---------- 常用工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
