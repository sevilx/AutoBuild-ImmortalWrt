# ============================================================
# 目标：armsr/armv8 —— 64 位 ARM（aarch64）通用 UEFI 镜像
# 适用：ARM 服务器 / 开发板 / KVM 虚拟机 / 绝大多数支持 UEFI 的 arm64 设备
# 产物：rootfs.img.gz、combined-efi.img.gz（可直接写盘或 dd）
# ============================================================

# ---------- 目标定义 ----------
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y

# ---------- 分区大小（arm64 机器普遍存储充裕，留 512M 根分区）----------
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# ---------- 存储 / USB ----------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_lsblk=y

# ---------- 常见有线网卡（PCIe / USB）----------
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y
CONFIG_PACKAGE_kmod-usb-net-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
