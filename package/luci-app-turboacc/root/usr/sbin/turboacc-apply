#!/bin/sh
# ============================================================================
#  turboacc-apply —— 把 /etc/config/turboacc 的设置落到实际系统
#    BBR        -> /etc/sysctl.d/99-turboacc.conf（fq + bbr）
#    流量分载   -> firewall.@defaults[0].flow_offloading / flow_offloading_hw
#    FullCone   -> firewall.@defaults[0].fullcone（依赖 kmod-nft-fullcone）
# ============================================================================
[ -f /lib/functions.sh ] && . /lib/functions.sh

SYSCTL_CONF="/etc/sysctl.d/99-turboacc.conf"
FW_CHANGED=0

config_load turboacc
config_get_bool BBR   config bbr 1
config_get_bool FLOW  config flow_offloading 1
config_get_bool HW    config flow_offloading_hw 1
config_get_bool FCONE config fullcone 1

# ------------------------------------------------------------------ BBR
if [ "${BBR}" = "1" ]; then
	cat > "${SYSCTL_CONF}" <<'EOF'
# generated by luci-app-turboacc
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
else
	cat > "${SYSCTL_CONF}" <<'EOF'
# generated by luci-app-turboacc
net.core.default_qdisc=fq_codel
net.ipv4.tcp_congestion_control=cubic
EOF
fi
sysctl -p "${SYSCTL_CONF}" >/dev/null 2>&1

# ------------------------------------------------------------------ FullCone 内核模块
if [ "${FCONE}" = "1" ]; then
	[ -d /sys/module/nft_fullcone ] || modprobe nft_fullcone 2>/dev/null
	if [ ! -d /sys/module/nft_fullcone ]; then
		echo "警告：nft_fullcone 模块未加载，FullCone NAT 无法生效（请安装 kmod-nft-fullcone）"
	fi
fi

# ------------------------------------------------------------------ 防火墙选项
set_fw_opt() {
	_opt="$1"
	_val="$2"
	_cur=$(uci -q get "firewall.@defaults[0].${_opt}")
	[ "${_cur}" = "${_val}" ] && return 0
	uci -q set "firewall.@defaults[0].${_opt}=${_val}" || return 1
	FW_CHANGED=1
	return 0
}

set_fw_opt flow_offloading "${FLOW}"
set_fw_opt flow_offloading_hw "${HW}"
set_fw_opt fullcone "${FCONE}"

if [ "${FW_CHANGED}" = "1" ]; then
	uci -q commit firewall
	if command -v fw4 >/dev/null 2>&1; then
		fw4 reload >/dev/null 2>&1
	else
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
	echo "防火墙规则已刷新"
fi

echo "Turbo ACC 已应用：BBR=${BBR} 软件分载=${FLOW} 硬件分载=${HW} FullCone=${FCONE}"
exit 0
